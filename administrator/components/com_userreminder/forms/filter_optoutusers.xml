<?xml version="1.0" encoding="UTF-8"?>
<form>
	<fields name="filter">
		<field
			name="search"
			type="text"
			inputmode="search"
			label="COM_USERREMINDER_OPTOUT_FILTER_SEARCH_LABEL"
			description="COM_USERREMINDER_OPTOUT_FILTER_SEARCH_DESC"
			hint="JSEARCH_FILTER"
		/>
	</fields>
	<fields name="list">
		<field
			name="fullordering"
			type="list"
			label="JGLOBAL_SORT_BY"
			class="js-select-submit-on-change"
			default="a.name ASC"
			validate="options"
		>
			<option value="">JGLOBAL_SORT_BY</option>
			<option value="a.name ASC">COM_USERREMINDER_OPTOUT_ORDER_NAME_ASC</option>
			<option value="a.name DESC">COM_USERREMINDER_OPTOUT_ORDER_NAME_DESC</option>
			<option value="a.username ASC">COM_USERREMINDER_OPTOUT_ORDER_USERNAME_ASC</option>
			<option value="a.username DESC">COM_USERREMINDER_OPTOUT_ORDER_USERNAME_DESC</option>
			<option value="a.email ASC">COM_USERREMINDER_OPTOUT_ORDER_EMAIL_ASC</option>
			<option value="a.email DESC">COM_USERREMINDER_OPTOUT_ORDER_EMAIL_DESC</option>
			<option value="a.registerDate ASC">COM_USERREMINDER_REGISTRATIONDATE_ASC</option>
			<option value="a.registerDate DESC">COM_USERREMINDER_REGISTRATIONDATE_DESC</option>
			<option value="a.lastvisitDate ASC">COM_USERREMINDER_OPTOUT_ORDER_LASTVISIT_ASC</option>
			<option value="a.lastvisitDate DESC">COM_USERREMINDER_OPTOUT_ORDER_LASTVISIT_DESC</option>
			<option value="a.id ASC">JGRID_HEADING_ID_ASC</option>
			<option value="a.id DESC">JGRID_HEADING_ID_DESC</option>
		</field>

		<field
			name="limit"
			type="limitbox"
			label="JGLOBAL_LIST_LIMIT"
			default="25"
			class="js-select-submit-on-change"
		/>
	</fields>
</form>
