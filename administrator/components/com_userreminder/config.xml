<?xml version="1.0" encoding="utf-8"?>
<config>
    <fieldset name="basic" label="COM_USERREMINDER_FIELDSET_BASIC">
        <field name="test_user" type="user" label="COM_USERREMINDER_TEST_USER"
               description="COM_USERREMINDER_TEST_USER_DESC"/>

        <field name="numberOfDays" type="list" default="1" class="form-select"
               label="COM_USERREMINDER_DAYS" description="COM_USERREMINDER_DAYS_TEXT">
            <option value="1">1</option>
            <option value="2">2</option>
            <option value="3">3</option>
            <option value="5">5</option>
            <option value="7">7</option>
            <option value="10">10</option>
            <option value="15">15</option>
            <option value="30">30</option>
            <option value="60">60</option>
            <option value="90">90</option>
        </field>

        <field name="enabledSendImed" type="radio" default="0"
               layout="joomla.form.field.radio.switcher"
               label="COM_USERREMINDER_EMAIL_IMED"
               description="COM_USERREMINDER_EMAIL_IMED_TEXT">
            <option value="0">JNO</option>
            <option value="1">JYES</option>
        </field>

        <field name="numberOfReminders" type="list" default="1" class="form-select"
               label="COM_USERREMINDER_NUMBER_REMINDERS"
               description="COM_USERREMINDER_NUMBER_REMINDERS_TEXT">
            <option value="1">1</option>
            <option value="2">2</option>
            <option value="3">3</option>
            <option value="5">5</option>
            <option value="10">10</option>
            <option value="20">20</option>
            <option value="50">50</option>
            <option value="100">100</option>
            <option value="1000">1000</option>
        </field>

        <field name="enabledBccToAdmin" type="radio" default="1"
               layout="joomla.form.field.radio.switcher"
               label="COM_USERREMINDER_EMAIL_ADMIN"
               description="COM_USERREMINDER_EMAIL_ADMIN_TEXT">
            <option value="0">JNO</option>
            <option value="1">JYES</option>
        </field>

        <field name="bccEmailAddress" type="text" default=""
               label="COM_USERREMINDER_BCC_EMAIL_ADDRESS"
               description="COM_USERREMINDER_BCC_EMAIL_ADDRESS_TEXT"/>

        <field name="maxemailstosend" type="number" default="20"
               label="COM_USERREMINDER_MAXEMAILS"
               description="COM_USERREMINDER_MAXEMAILS_TEXT"/>

        <field name="number_email" type="number" default="50"
               label="COM_USERREMINDER_NUMBER_EMAIL_IN_A_RECORDSET"
               description="COM_USERREMINDER_NUMBER_EMAIL_IN_A_RECORDSET_TEXT"/>

        <field name="passwordReset" type="text" default=""
               label="COM_USERREMINDER_PASSWORD_RESET"
               description="COM_USERREMINDER_PASSWORD_RESET_DESC"/>

        <field name="activateURL" type="text" default=""
               label="COM_USERREMINDER_ACTIVATION_LINK_TEXT"
               description="COM_USERREMINDER_ACTIVATION_LINK_TEXT_HELP"/>

        <field name="debugUserReminder" type="radio" default="0"
               layout="joomla.form.field.radio.switcher"
               label="COM_USERREMINDER_DEBUG"
               description="COM_USERREMINDER_DEBUG_TEXT">
            <option value="0">JNO</option>
            <option value="1">JYES</option>
        </field>
    </fieldset>

    <fieldset name="scheduler" label="COM_USERREMINDER_FIELDSET_SCHEDULER">
        <field name="enabledScheduledExecution" type="radio" default="0"
               layout="joomla.form.field.radio.switcher"
               label="COM_USERREMINDER_SCHEDULED_ENABLE"
               description="COM_USERREMINDER_SCHEDULED_ENABLE_TEXT">
            <option value="0">JNO</option>
            <option value="1">JYES</option>
        </field>

        <field name="scheduledExecutionType" type="list" default="1" class="form-select"
               showon="enabledScheduledExecution:1"
               label="COM_USERREMINDER_SCHEDULED_TYPE"
               description="COM_USERREMINDER_SCHEDULED_TYPE_TEXT">
            <option value="1">COM_USERREMINDER_TYPE1</option>
            <option value="2">COM_USERREMINDER_TYPE2</option>
            <option value="3">COM_USERREMINDER_TYPE3</option>
        </field>

        <field name="scheduledExecutionTime" type="SchedulerTime" default="0"
               showon="enabledScheduledExecution:1"
               label="COM_USERREMINDER_SCHEDULED_TIME"
               description="COM_USERREMINDER_SCHEDULED_TIME_TEXT">
            <option value="">COM_USERREMINDER_SELECT_TIME</option>
        </field>

        <field name="enabledScheduledActivationReminders" type="radio" default="0"
               showon="enabledScheduledExecution:1"
               layout="joomla.form.field.radio.switcher"
               label="COM_USERREMINDER_SCHEDULED_ACTIVATION_REMINDERS_ENABLE"
               description="COM_USERREMINDER_SCHEDULED_ACTIVATION_REMINDERS_ENABLE_TEXT">
            <option value="0">JNO</option>
            <option value="1">JYES</option>
        </field>

        <field name="enabledScheduledUserReminders" type="radio" default="0"
               showon="enabledScheduledExecution:1"
               layout="joomla.form.field.radio.switcher"
               label="COM_USERREMINDER_SCHEDULED_USER_REMINDERS_ENABLE"
               description="COM_USERREMINDER_SCHEDULED_USER_REMINDERS_ENABLE_TEXT">
            <option value="0">JNO</option>
            <option value="1">JYES</option>
        </field>
    </fieldset>

    <fieldset name="not_activated" label="COM_USERREMINDER_FIELDSET_NOT_ACTIVATED">
        <field name="enableActivateReminder" type="radio" default="0"
               layout="joomla.form.field.radio.switcher"
               label="COM_USERREMINDER_LOGIN_ENABLED"
               description="COM_USERREMINDER_LOGIN_ENABLED_TEXT">
            <option value="0">JNO</option>
            <option value="1">JYES</option>
        </field>

        <field name="enableDeleteUsers" type="radio" default="0"
               showon="enableActivateReminder:1"
               layout="joomla.form.field.radio.switcher"
               label="COM_USERREMINDER_ACTIONDELETE"
               description="COM_USERREMINDER_DELETEUSERS_TEXT">
            <option value="0">JNO</option>
            <option value="1">JYES</option>
        </field>

        <field name="useCBActivation" type="radio" default="0"
               showon="enableActivateReminder:1"
               layout="joomla.form.field.radio.switcher"
               label="COM_USERREMINDER_CB_REG"
               description="COM_USERREMINDER_CB_REG_TEXT">
            <option value="0">JNO</option>
            <option value="1">JYES</option>
        </field>

        <field name="regactivationEmailSubject" type="text" default="Please complete registration for [NAME] at [SITE_NAME]"
               showon="enableActivateReminder:1"
               label="COM_USERREMINDER_REG_EMAIL_SUBJECT"
               description="COM_USERREMINDER_REG_EMAIL_SUBJECT_TEXT"/>

        <field name="regActivationEmailBodyHTML" type="editor" filter="raw"
               showon="enableActivateReminder:1"
               label="COM_USERREMINDER_CUSTOM_EMAIL_HTML_MESSAGES_REM"
               description="COM_USERREMINDER_REG_EMAIL_TEXT_BODY"
               default="Hello [NAME],&lt;br /&gt;&lt;br /&gt;We have noticed that you have not completed registering at [SITE_NAME].&lt;br /&gt;&lt;br /&gt;Your account is created and must be activated before you can use it.&lt;br /&gt;&lt;br /&gt;To activate the account click on the following link or copy-paste it in your browser:&lt;br /&gt;[ACTIVATE_URL]&lt;br /&gt;&lt;br /&gt;After activation you may login to [SITE_URL] using the following username and password:&lt;br /&gt;&lt;br /&gt;Username: [USERNAME]&lt;br /&gt;Forgot your Password? : [PASSWORD_RESET]&lt;br /&gt;&lt;br /&gt;If you no longer wish to receive these reminders then unsubscribe here [OPTOUT]"/>
    </fieldset>

    <fieldset name="never_logged_in" label="COM_USERREMINDER_FIELDSET_NEVER_LOGGED">
        <field name="enableLoginReminder" type="radio" default="0"
               layout="joomla.form.field.radio.switcher"
               label="COM_USERREMINDER_LOGIN_ENABLED"
               description="COM_USERREMINDER_LOGIN_ENABLED_TEXT">
            <option value="0">JNO</option>
            <option value="1">JYES</option>
        </field>

        <field name="enableDeleteUsersLogin" type="radio" default="0"
               showon="enableLoginReminder:1"
               layout="joomla.form.field.radio.switcher"
               label="COM_USERREMINDER_DELETEUSERS_LOGIN"
               description="COM_USERREMINDER_DELETEUSERS_LOGIN_TEXT">
            <option value="0">JNO</option>
            <option value="1">JYES</option>
        </field>

        <field name="regloginemailsubject" type="text" default="You have successfully activated your account at [SITE_NAME]"
               showon="enableLoginReminder:1"
               label="COM_USERREMINDER_LOGIN_EMAIL_SUBJECT"
               description="COM_USERREMINDER_LOGIN_EMAIL_SUBJECT_TEXT"/>

        <field name="regLoginEmailBodyHTML" type="editor" filter="raw"
               showon="enableLoginReminder:1"
               label="COM_USERREMINDER_CUSTOM_EMAIL_HTML_MESSAGES_REM"
               description="COM_USERREMINDER_REG_LOGIN_TEXT_BODY"
               default="Hello [NAME],&lt;br /&gt;&lt;br /&gt;We have noticed that you have successfully registered you account at [SITE_NAME].&lt;br /&gt;&lt;br /&gt;However you have not logged in since activating your account.&lt;br /&gt;&lt;br /&gt;To access the website click on the following link or copy-paste it in your browser:&lt;br /&gt;[SITE_URL]&lt;br /&gt;&lt;br /&gt;You may login using the following username and password:&lt;br /&gt;&lt;br /&gt;Username: [USERNAME]&lt;br /&gt;Forgot your Password? : [PASSWORD_RESET]&lt;br /&gt;&lt;br /&gt;If you no longer wish to receive these reminders then unsubscribe here [OPTOUT]"/>
    </fieldset>

    <fieldset name="existing_user" label="COM_USERREMINDER_FIELDSET_EXISTING_USER">
        <field name="numberOfDaysExistingUser" type="list" default="180" class="form-select"
               label="COM_USERREMINDER_DAYS_EXISTINGUSER"
               description="COM_USERREMINDER_DAYS_EXISTINGUSER_TEXT">
            <option value="30">30</option>
            <option value="60">60</option>
            <option value="90">90</option>
            <option value="180">180</option>
            <option value="360">360</option>
            <option value="720">720</option>
        </field>

        <field name="enableDeleteExistingUsers" type="radio" default="0"
               layout="joomla.form.field.radio.switcher"
               label="COM_USERREMINDER_DELETEUSERS"
               description="COM_USERREMINDER_DELETEUSERS_TEXT">
            <option value="0">JNO</option>
            <option value="1">JYES</option>
        </field>

        <field name="removefromusergroups" type="usergrouplist" multiple="true"
               showon="enableDeleteExistingUsers:0"
               label="COM_USERREMINDER_REMOVE_FROM_GROUPS"
               description="COM_USERREMINDER_REMOVE_FROM_GROUPS_DESC"/>

        <field name="regLoginEmailSubjectVisited" type="text" default="We have missed you at [SITE_NAME]"
               label="COM_USERREMINDER_LOGIN_EMAIL_SUBJECT"
               description="COM_USERREMINDER_LOGIN_EMAIL_SUBJECT_TEXT"/>

        <field name="regExistingUserEmailBodyHTML" type="editor" filter="raw"
               label="COM_USERREMINDER_CUSTOM_EMAIL_HTML_MESSAGES_REM"
               description="COM_USERREMINDER_REG_EXISTINGUSER_TEXT_BODY"
               default="Hello [NAME],&lt;br /&gt;&lt;br /&gt;We have noticed that you have not visited [SITE_NAME] for a while.&lt;br /&gt;&lt;br /&gt;If you no longer wish to receive these reminders then unsubscribe here [OPTOUT]"/>
    </fieldset>
</config>